# OAuth-токен Яндекс Директа. Не публикуйте реальный токен в Git.
YANDEX_DIRECT_TOKEN=

# Логин клиента нужен для агентского аккаунта. Для собственного аккаунта оставьте пустым.
YANDEX_DIRECT_CLIENT_LOGIN=

# ID целей через запятую, например: 111111111,222222222
YANDEX_DIRECT_GOAL_IDS=

# Необязательный период в формате YYYY-MM-DD.
YANDEX_DIRECT_DATE_FROM=
YANDEX_DIRECT_DATE_TO=

# Необязательный путь к CSV, создаваемому экспортёром.
YANDEX_DIRECT_OUTPUT_FILE=
